rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{allPaths=**} {
      allow read: if true;
        // Image uploads currently use the authenticated server route and
        // Cloudinary, not the Firebase client SDK.
        allow write, delete: if false;
    }

      match /{allPaths=**} {
        allow read, write: if false;
      }
  }
}